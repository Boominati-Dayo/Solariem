# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
#   cp .env.example .env.local
#
# Every variable the codebase actually reads is listed here. Verified against
# a grep for process.env.* across src/ and scripts/ — if you add one to the app,
# add it here too, or the next person will hit the same "MONGODB_URI is not set"
# confusion on a script.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Single source of truth for the connection. The app reads only this.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
# Database name. Must match the database the data actually lives in.
MONGODB_DB="Banking-Refund"
# There are deliberately no MONGODB_USERNAME / MONGODB_PASSWORD variables.
# Nothing reads them, and a second copy of the Atlas password is a second thing
# to rotate and a second place for it to leak from. MONGODB_URI is the only
# source of truth for the connection.

# --- Authentication --------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate with: node scripts/generate-jwt-secret.js
# If this is unset, src/lib/auth/jwt.ts falls back to a hardcoded string that is
# published in this repository, which means anyone could forge a session token.
JWT_SECRET=""
# Token lifetime. Go's duration syntax: 15m, 24h, 7d.
JWT_EXPIRES_IN="7d"

# --- Email (Zoho SMTP) -----------------------------------------------------
# Zoho app passwords are 16 characters and usually contain a space; paste the
# value with the space removed or quoted.
# 465 is implicit TLS, 587 is STARTTLS. src/lib/email.ts derives `secure` from
# the port, so either works without a code change. Google requires an App
# Password (https://myaccount.google.com/apppasswords), not the account
# password; the 16 characters are displayed in four groups of four and the
# spaces are stripped in code, so the displayed form works.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# The sending address. MUST match a verified sender in the Zoho account or
# every email will be rejected on SPF/DKIM.
SMTP_USER="support@example.com"
# code reads SMTP_PASS first, then SMTP_PASSWORD — set only one.
SMTP_PASS=""
# On Google this MUST be the authenticated address above, or a Workspace alias
# verified in the account. Any other From: is rejected or silently rewritten.
EMAIL_FROM='"Solariem" <support@example.com>'
# Where inbound enquiries get delivered.
ADMIN_EMAIL="support@example.com"

# --- Cloudinary (evidence uploads) ----------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# CLOUDINARY_URL is intentionally absent. src/app/api/upload/route.ts calls the
# Cloudinary REST API with the three values above, so a connection URL is
# neither read nor needed, and it would repeat the key and secret in a second
# place that is easy to rotate one copy of and forget the other.

# --- URLs ------------------------------------------------------------------
# Where the app is served from. Used in emails and CORS.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical origin for metadata, Open Graph, sitemap and JSON-LD.
# Set to the real domain at deploy time. Do not point this at a domain you do
# not own — every canonical URL and OG tag derives from it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed scripts only -----------------------------------------------------
# Read by scripts/seed-admin.js and scripts/seed-unverified-user.js. Not needed
# by the running app.
ADMIN_PASSWORD=""
ADMIN_PIN=""
UK_EMAIL=""
UK_PASSWORD=""
UK_PIN=""
UNVERIFIED_EMAIL=""
UNVERIFIED_PASSWORD=""
UNVERIFIED_PIN=""
